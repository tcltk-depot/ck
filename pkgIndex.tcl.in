# -*- tcl -*-
#
# Tcl package index file - generated from pkgIndex.tcl.in
#

package ifneeded @PACKAGE_NAME@ @PACKAGE_VERSION@ \
    [list apply [list {dir} {
        package require platform
        set package_ns ::@PACKAGE_NAME@
        set initName [string totitle @PACKAGE_NAME@]
        if {[package vsatisfies [package require Tcl] 9]} {
            set fileName "@PKG_LIB_FILE9@"
        } else {
            set fileName "@PKG_LIB_FILE8@"
        }

        if {[file exists [file join $dir library]]} {
            set ::ck_library [file normalize [file join $dir library]]
        } else {
            set ::ck_library [file normalize $dir]
        }

        set platformId [platform::identify]
        set searchPaths [list [file join $dir $platformId] \
                             {*}[lmap platformId [platform::patterns $platformId] {
                                 file join $dir $platformId
                             }] \
                             $dir]
        foreach path $searchPaths {
            set lib [file join $path $fileName]
            if {[file exists $lib]} {
                uplevel #0 [list load $lib $initName]
                # Load was successful
                set ${package_ns}::dll_path $lib
                set ${package_ns}::package_dir $dir
                # Legacy contract: package require @PACKAGE_NAME@ creates
                # the main window (.) on the controlling tty and wires
                # up class bindings.  ck::open sources library/ck.tcl on
                # success, so a single call covers both pieces.  Tests
                # that need to drive Ck against a controlled pty set
                # ::ck_no_auto_open=1 before requiring the package and
                # call [ck::open -pty $fd] themselves.  A plain global
                # is used (rather than a namespace var) so the test
                # harness can set it without first creating ::ck.
                if {![info exists ::ck_no_auto_open] || !$::ck_no_auto_open} {
                    uplevel #0 [list ::@PACKAGE_NAME@::open .]
                }
                return
            }
        }
        error "Could not locate $fileName in directories [join $searchPaths {, }]"
    }] $dir]
